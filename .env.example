# The shop refuses to start without the vars in the sections above the optional knobs.

# --- gelato (fulfilment) ---
# API key from the Gelato dashboard → Settings → API.
GELATO_TOKEN=
# The Gelato store whose products the shop sells (the id in the store page URL).
GELATO_STORE_ID=
# Gelato webhooks are unsigned; append ?token=<value> to the webhook URL you
# register in the Gelato dashboard to authenticate callbacks.
GELATO_WEBHOOK_SECRET=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- shop identity ---
SHOP_PUBLIC_URL=http://localhost:3000
SHOP_CONTACT_EMAIL=mattf@h4ks.com

# --- smtp ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="h4ks shop <noreply@h4ks.com>"
SMTP_SECURE=false

# --- optional knobs (have sensible defaults, only set to override) ---
# Must match the Gelato store currency.
# SHOP_CURRENCY=EUR
# SHOP_NAME="h4ks shop"
# Place REAL Gelato orders (charged + produced). Leave false for local/staging,
# where checkouts place draft orders. Set true in production.
# GELATO_LIVE_ORDERS=false
