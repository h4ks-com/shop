# All vars below are required — the shop refuses to start without them.

# --- gelato (fulfilment) ---
# API key from the Gelato dashboard → Settings → API. One global account ships
# worldwide and auto-routes to the nearest facility.
GELATO_TOKEN=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- shop identity ---
SHOP_PUBLIC_URL=http://localhost:3000
SHOP_CONTACT_EMAIL=mattf@h4ks.com

# --- smtp ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="h4ks shop <noreply@h4ks.com>"
SMTP_SECURE=false

# --- optional knobs (have sensible defaults, only set to override) ---
# SHOP_CURRENCY=USD                                              # USD | EUR | GBP
# SHIPPING_MARKUP_CENTS=490                                      # per-item markup baked into price (free shipping at checkout)
# SHOP_NAME="h4ks shop"
# Gelato webhooks aren't signed; set this and append ?token=<value> to the
# webhook URL you register in the Gelato dashboard to authenticate callbacks.
# GELATO_WEBHOOK_SECRET=

# --- catalog generator only (local CLI) — NOT used by the running shop ----
# `npm run gelato:build-catalog` resolves Gelato productUids into
# src/data/catalog.json. It reads GELATO_TOKEN above; no extra vars needed.
