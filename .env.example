# All vars below are required — the shop refuses to start without them.

# --- spreadconnect ---
SPREADCONNECT_TOKEN=
# `openssl rand -hex 32` — used to verify incoming Spreadconnect webhooks.
SPREADCONNECT_WEBHOOK_SECRET=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- shop identity ---
SHOP_PUBLIC_URL=http://localhost:3000
SHOP_CONTACT_EMAIL=mattf@h4ks.com

# --- smtp ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="h4ks shop <noreply@h4ks.com>"
SMTP_SECURE=false

# --- optional knobs (have sensible defaults, only set to override) ---
# SPREADCONNECT_BASE_URL=https://api.spreadconnect-staging.app   # for sandbox
# SHOP_CURRENCY=USD                                              # USD | EUR | GBP
# SHOP_TAX_TYPE=NOT_TAXABLE                                      # NOT_TAXABLE | SALESTAX | VAT
# SHIPPING_MARKUP_CENTS=490                                      # per-item markup baked into price (free shipping at checkout)
# SHOP_NAME="h4ks shop"
# SC_ACTIVE_ACCOUNTS=EU                                          # comma list — set to "EU,US" when NA account is wired up

# --- sync-only (local CLI) — NOT used by the running shop ----------------
# Required ONLY to run `npm run sync:sc`. Keep these out of production env;
# the sync is a local-machine operation and these tokens are higher-trust
# than the runtime token (sync deletes & creates articles).
# Direction is explicit — source is read-only, target is what gets modified.
# SC_SYNC_SOURCE=EU                                              # which account we read from (default EU)
# SC_SYNC_TARGET=US                                              # which account we write to  (default US)
# SC_SYNC_EU_TOKEN=                                              # API token for the EU SC account
# SC_SYNC_US_TOKEN=                                              # API token for the NA SC account
# SC_EUR_TO_USD=1.08                                             # FX rate applied at sync time (deterministic)
# SC_US_PRICE_MULTIPLIER=1.0                                     # extra US-side markup, e.g. 1.10 = +10%
# SC_US_PRICE_ROUND=cents                                        # cents | ninety_nine
